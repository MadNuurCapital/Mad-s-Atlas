# =============================================================================
# Mad's Atlas — environment variable contract
# =============================================================================
#
# Copy to `.env.local` for local development. `.env.local` is git-ignored.
#
#   cp .env.example .env.local
#
# EVERY variable here is validated at startup by `src/lib/validation/env.ts`
# (Zod). Missing or malformed required values cause a loud, safe startup
# failure — the app never boots half-configured, and secret VALUES are never
# printed in the error.
#
# -----------------------------------------------------------------------------
# THE ONE RULE
# -----------------------------------------------------------------------------
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# PUBLIC FOREVER. Everything else is server-only and must never be imported
# from a client component, passed as a prop, or logged.
#
# Server-only, never in the browser:
#   SUPABASE_SECRET_KEY, SUPABASE_DB_URL, GEMINI_API_KEY,
#   GOOGLE_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY, VAPID_PRIVATE_KEY
#
# A Playwright test in `tests/e2e/` asserts that none of these strings appear
# in any browser network payload or JS bundle. See TESTING.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Public base URL of this deployment. Used to build OAuth redirect URIs and
# absolute links in notifications. No trailing slash.
# Local:      http://localhost:3000
# Production: https://<your-site>.netlify.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The ONLY email address permitted to sign in. Everything else is rejected at
# four independent layers (see SECURITY.md § Owner restriction).
# Compared case-insensitively after Unicode normalisation and trimming.
ATLAS_OWNER_EMAIL=

# Display timezone. All timestamps are STORED in UTC and DISPLAYED here.
# Singapore is a fixed UTC+08:00 with no daylight saving — see SCHEDULED_JOBS.md.
ATLAS_TIMEZONE=Asia/Singapore


# -----------------------------------------------------------------------------
# Supabase — public (browser-safe)
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — format `sb_publishable_...`. Safe to ship to the browser;
# it carries no privileges beyond what Row Level Security allows.
# This REPLACES the legacy `anon` key, which Supabase deprecates end of 2026.
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# Supabase — server-only  ⚠ NEVER expose to the browser
# -----------------------------------------------------------------------------

# Secret key — format `sb_secret_...`. BYPASSES ROW LEVEL SECURITY ENTIRELY.
# Replaces the legacy `service_role` key. Used only by:
#   - src/lib/supabase/admin.ts  (server modules only)
#   - scripts/seed-owner.ts
#   - Supabase Edge Functions
# If this ever leaks, rotate it immediately in the dashboard.
SUPABASE_SECRET_KEY=

# Direct Postgres connection string. Used by `scripts/generate-types.ts` and by
# integration tests that need to assert RLS behaviour as different roles.
# Dashboard → Project Settings → Database → Connection string (URI)
# Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=


# -----------------------------------------------------------------------------
# Gemini — server-only  ⚠ NEVER expose to the browser
# -----------------------------------------------------------------------------

# Permanent API key from https://aistudio.google.com/apikey
# The browser NEVER receives this. Voice sessions use short-lived, single-use
# ephemeral tokens minted by /api/gemini/live-token. See GEMINI_LIVE_SETUP.md.
GEMINI_API_KEY=

# Realtime voice model. Verified current as of August 2026.
# Kept configurable because preview model IDs change without notice — the app
# hard-codes no model string anywhere.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Text/reasoning model: tool reasoning, research synthesis, briefings,
# summarisation, meeting prep, memory extraction. `gemini-3.6-flash` is GA.
GEMINI_TEXT_MODEL=gemini-3.6-flash

# Embedding model for semantic memory search.
# IMPORTANT: the database column is `vector(1536)`. This model defaults to 3072
# dimensions; the app requests 1536 via output dimensionality, because pgvector
# cannot build an index on a vector wider than 2000 dimensions.
# Changing this value requires a schema migration AND re-embedding every
# memory row — see MEMORY_SYSTEM.md § Changing embedding dimensions.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001


# -----------------------------------------------------------------------------
# Google OAuth (Gmail + Calendar)
# -----------------------------------------------------------------------------
# Full walkthrough: GOOGLE_OAUTH_SETUP.md
#
# Scopes requested (minimum practical set — nothing broader):
#   openid
#   email
#   profile
#   https://www.googleapis.com/auth/calendar.readonly
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.compose
#
# Deliberately NOT requested: gmail.send, gmail.modify, Drive, Contacts.

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Also entered into Supabase Dashboard → Authentication → Providers → Google.
GOOGLE_CLIENT_ID=

# ⚠ SERVER-ONLY. Needed for the server-side refresh-token exchange.
GOOGLE_CLIENT_SECRET=

# Must match an Authorised redirect URI on the OAuth client EXACTLY.
# Supabase-hosted callback: https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_REDIRECT_URI=


# -----------------------------------------------------------------------------
# Encryption  ⚠ NEVER expose to the browser, never store in the database
# -----------------------------------------------------------------------------

# AES-256-GCM key protecting Google access & refresh tokens at rest in
# public.connected_accounts. 32 random bytes, base64-encoded.
#
# Generate with:
#     openssl rand -base64 32
#
# Store as a Netlify environment secret AND a Supabase Edge Function secret
# (scheduled jobs need Google access too):
#     supabase secrets set TOKEN_ENCRYPTION_KEY="<value>"
#
# Losing this key means every stored Google token becomes undecryptable and
# Muhammad must reconnect Google. Rotating it requires re-encrypting existing
# rows — see SECURITY.md § Key rotation.
TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Web push notifications
# -----------------------------------------------------------------------------
# Generate BOTH keys together — they are a matched pair:
#     npx web-push generate-vapid-keys
#
# Regenerating them invalidates every existing browser subscription; users must
# re-subscribe.

# Browser-safe by design: the public half of the VAPID keypair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ⚠ SERVER-ONLY.
VAPID_PRIVATE_KEY=

# Contact URI for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=


# -----------------------------------------------------------------------------
# Optional — observability
# -----------------------------------------------------------------------------

# Leave blank to disable error reporting entirely. When set, errors are
# redacted before transmission (see src/lib/validation/redact.ts): no tokens,
# no keys, no email bodies, no memory content.
SENTRY_DSN=
